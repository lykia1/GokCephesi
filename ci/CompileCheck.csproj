<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sadece derleme kontrolü içindir. Unity bu dosyayı kullanmaz. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <UnityPkg Condition="'$(UnityPkg)' == ''">RocketModFix.UnityEngine.Redist</UnityPkg>
    <UnityVersion Condition="'$(UnityVersion)' == ''">2022.3.*</UnityVersion>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0162;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="$(UnityPkg)" Version="$(UnityVersion)" />
  </ItemGroup>
</Project>
